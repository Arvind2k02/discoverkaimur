  "travelTips": [
    {
      "label": "Getting There",
      "tip": "Nearest railway station: Bhabhua Road on the Delhi–Kolkata main line. Taxis available from station.",
      "id": "kx-zMvdm2jcLsP37mOVYD"
    },
    {
      "label": "Best Season",
      "tip": "October to March — cool and pleasant. Avoid May–June (extreme heat). Monsoon (Jul–Sep) for waterfalls.",
      "id": "3NcHEx9Z1cROcH4RXrESn"
    },
    {
      "label": "Where to Stay",
      "tip": "Bhabhua has budget hotels and guesthouses. Book in advance during Chhath Puja season (Oct–Nov).",
      "id": "jhuDkssgV2F6XsImqACUP"
    },
    {
      "label": "Language",
      "tip": "Bhojpuri and Hindi are widely spoken. Basic Hindi phrases will go a long way with locals.",
      "id": "Te2dRvXZ6oitVlvhYmu4E"
    },
    {
      "label": "Budget",
      "tip": "₹1,500–₹2,500 per day including food, stay, and local transport. Carry cash — ATMs are limited outside Bhabhua.",
      "id": "3i2teRM-YGFufcUu7XtD0"
    },
    {
      "label": "Photography",
      "tip": "Carry a wide-angle lens for waterfalls and landscapes. Golden hour at Mundeshwari Hill is spectacular.",
      "id": "oajrmElBKY0eMnRomcQYI"
    }
  ]
